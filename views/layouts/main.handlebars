<!DOCTYPE html>
<html lang="{{workspacePreferences.language_code}}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{csrfToken}}">
    <title>StockFlow · Inventory Management</title>
    <script>
        // Supply the current session token to fetch requests that modify application data.
        window.stockFlowCsrfHeaders = () => ({
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]') ? .content || ''
        })
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@700;800&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="/socket.io/socket.io.js"></script>
    <style>
        /* ── Design tokens ─────────────────────────────────── */
        :root {
            --sidebar-w: 256px;
            --topbar-h: 60px;

            --color-bg: #f1f5f9;
            --color-surface: #ffffff;
            --color-border: #e2e8f0;
            --color-border-soft: #f1f5f9;

            --color-sidebar-bg: #0f172a;
            --color-sidebar-hover: rgba(255, 255, 255, .07);
            --color-sidebar-active: #1e293b;

            --color-text: #0f172a;
            --color-muted: #64748b;
            --color-label: #94a3b8;

            --color-primary: #2563eb;
            --color-primary-hover: #1d4ed8;
            --color-primary-soft: rgba(37, 99, 235, .1);

            --color-success: #059669;
            --color-success-soft: rgba(5, 150, 105, .1);

            --color-warning: #d97706;
            --color-warning-soft: rgba(217, 119, 6, .1);

            --color-danger: #dc2626;
            --color-danger-soft: rgba(220, 38, 38, .1);

            --color-info: #0284c7;
            --color-info-soft: rgba(2, 132, 199, .1);

            --shadow-sm: 0 1px 3px rgba(15, 23, 42, .06), 0 1px 2px rgba(15, 23, 42, .04);
            --shadow-md: 0 4px 12px rgba(15, 23, 42, .08), 0 2px 4px rgba(15, 23, 42, .05);
            --shadow-lg: 0 10px 32px rgba(15, 23, 42, .12);

            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;
        }

        /* ── Base ──────────────────────────────────────────── */
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        body {
            background: var(--color-bg);
            color: var(--color-text);
            font-family: 'Inter', system-ui, sans-serif;
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            font-family: 'Manrope', sans-serif;
            letter-spacing: -0.03em;
        }

        /* ── App shell ─────────────────────────────────────── */
        .app-shell {
            display: flex;
            min-height: 100vh;
        }

        /* ── Sidebar ───────────────────────────────────────── */
        .sidebar {
            width: var(--sidebar-w);
            flex: 0 0 var(--sidebar-w);
            background: var(--color-sidebar-bg);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            overflow-y: auto;
            z-index: 200;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px 18px 16px;
            text-decoration: none;
            border-bottom: 1px solid rgba(255, 255, 255, .06);
            margin-bottom: 8px;
        }

        .sidebar-logo-mark {
            width: 34px;
            height: 34px;
            background: var(--color-primary);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .sidebar-logo-text {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 1.1rem;
            color: #fff;
            letter-spacing: -0.02em;
        }

        .sidebar-logo-text span {
            color: var(--color-primary);
            /* Chromatic accent on "Flow" part */
        }

        .sidebar-section {
            padding: 8px 10px 4px;
        }

        .sidebar-section+.sidebar-section {
            margin-top: 4px;
            border-top: 1px solid rgba(255, 255, 255, .06);
            padding-top: 12px;
        }

        .sidebar-section-title {
            color: var(--color-label);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 8px 6px;
            margin: 0;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 10px;
            color: rgba(255, 255, 255, .62);
            font-weight: 500;
            font-size: 13.5px;
            padding: 8px 10px;
            border-radius: var(--radius-sm);
            text-decoration: none;
            transition: background .15s ease, color .15s ease;
            margin-bottom: 1px;
        }

        .sidebar-link svg {
            flex-shrink: 0;
            opacity: .7;
            transition: opacity .15s ease;
        }

        .sidebar-link:hover,
        .sidebar-link:focus-visible {
            background: var(--color-sidebar-hover);
            color: #fff;
        }

        .sidebar-link:hover svg,
        .sidebar-link:focus-visible svg {
            opacity: 1;
        }

        .sidebar-link.active {
            background: var(--color-sidebar-active);
            color: #fff;
            font-weight: 600;
        }

        .sidebar-link.active svg {
            opacity: 1;
        }

        .sidebar-cta {
            margin: auto 10px 16px;
            padding-top: 12px;
        }

        .sidebar-cta a {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--color-primary);
            color: #fff;
            font-weight: 600;
            font-size: 13px;
            padding: 9px 14px;
            border-radius: var(--radius-sm);
            text-decoration: none;
            transition: background .15s ease;
        }

        .sidebar-cta a:hover {
            background: var(--color-primary-hover);
            color: #fff;
        }

        /* ── Main content area ─────────────────────────────── */
        .main-content {
            margin-left: var(--sidebar-w);
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        /* ── Top bar ───────────────────────────────────────── */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 100;
            height: var(--topbar-h);
            background: var(--color-surface);
            border-bottom: 1px solid var(--color-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 clamp(1rem, 3vw, 2rem);
            box-shadow: var(--shadow-sm);
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--color-muted);
            font-size: 13px;
        }

        .topbar-left a {
            color: var(--color-muted);
            text-decoration: none;
        }

        .topbar-left a:hover {
            color: var(--color-text);
        }

        .topbar-sep {
            color: var(--color-border);
        }

        .topbar-page {
            color: var(--color-text);
            font-weight: 600;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .workspace-pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: rgba(5, 150, 105, 0.1);
            border: 1px solid rgba(5, 150, 105, 0.18);
            color: #047857;
            border-radius: 999px;
            padding: 0.38rem 0.7rem;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #10b981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
        }

        .topbar-date {
            font-size: 12px;
            color: var(--color-muted);
        }

        .app-alert {
            margin: 0 0 1.25rem;
            border-radius: var(--radius-sm);
            border-left: 4px solid transparent;
            font-size: 13px;
            font-weight: 600;
        }

        .app-alert.alert-success {
            background: var(--color-success-soft);
            border-left-color: var(--color-success);
            color: #065f46;
        }

        .app-alert.alert-danger {
            background: var(--color-danger-soft);
            border-left-color: var(--color-danger);
            color: #991b1b;
        }

        .topbar-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--color-primary-soft);
            border: 2px solid var(--color-border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 11px;
            color: var(--color-primary);
        }

        /* ── Page content ──────────────────────────────────── */
        .content-wrap {
            flex: 1;
            padding: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 3vw, 2.5rem);
            max-width: 1600px;
            width: 100%;
        }

        /* ── Page header ───────────────────────────────────── */
        .page-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1.75rem;
        }

        .page-header p:last-child {
            margin-bottom: 0;
        }

        .page-eyebrow {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--color-primary);
            margin-bottom: 4px;
        }

        h1.page-title {
            font-size: clamp(1.5rem, 2.5vw, 2rem);
            font-weight: 800;
            margin: 0 0 4px;
            line-height: 1.2;
        }

        .page-subtitle {
            color: var(--color-muted);
            margin: 0;
            font-size: 13.5px;
        }

        /* ── KPI cards ─────────────────────────────────────── */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem;
            margin-bottom: 1.75rem;
        }

        .kpi-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            padding: 1.25rem 1.4rem;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .kpi-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .kpi-icon {
            width: 38px;
            height: 38px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .kpi-icon.indigo {
            background: var(--color-primary-soft);
            color: var(--color-primary);
        }

        .kpi-icon.emerald {
            background: var(--color-success-soft);
            color: var(--color-success);
        }

        .kpi-icon.amber {
            background: var(--color-warning-soft);
            color: var(--color-warning);
        }

        .kpi-icon.sky {
            background: var(--color-info-soft);
            color: var(--color-info);
        }

        .kpi-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--color-muted);
            text-transform: uppercase;
            letter-spacing: .07em;
        }

        .kpi-value {
            font-family: 'Manrope', sans-serif;
            font-size: 1.9rem;
            font-weight: 800;
            line-height: 1;
            color: var(--color-text);
        }

        /* ── Section panel ─────────────────────────────────── */
        .section-panel {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
        }

        .section-panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 1.4rem;
            border-bottom: 1px solid var(--color-border);
            gap: 1rem;
        }

        .section-panel-title {
            font-family: 'Manrope', sans-serif;
            font-size: 15px;
            font-weight: 700;
            margin: 0;
            color: var(--color-text);
        }

        .section-panel-subtitle {
            font-size: 12px;
            color: var(--color-muted);
            margin: 2px 0 0;
        }

        .section-panel-body {
            padding: 1.25rem 1.4rem;
        }

        /* ── Tables ────────────────────────────────────────── */
        .table {
            --bs-table-bg: transparent;
            --bs-table-border-color: var(--color-border);
            --bs-table-hover-bg: #f8fafc;
            font-size: 13.5px;
        }

        .table thead th {
            color: var(--color-muted);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .07em;
            text-transform: uppercase;
            border-bottom: 1px solid var(--color-border) !important;
            padding: .75rem 1rem;
            white-space: nowrap;
            background: #f8fafc;
        }

        .table tbody td {
            padding: .75rem 1rem;
            vertical-align: middle;
            border-color: var(--color-border-soft);
            color: var(--color-text);
        }

        .table tbody tr:last-child td {
            border-bottom: 0;
        }

        .table-hover tbody tr:hover td {
            background: #f8fafc;
        }

        /* ── Buttons ───────────────────────────────────────── */
        .btn {
            font-weight: 600;
            font-size: 13px;
            border-radius: var(--radius-sm);
            transition: all .15s ease;
        }

        .btn-primary {
            background: var(--color-primary);
            border-color: var(--color-primary);
            color: #fff;
        }

        .btn-primary:hover,
        .btn-primary:focus {
            background: var(--color-primary-hover);
            border-color: var(--color-primary-hover);
            color: #fff;
        }

        .btn-success {
            background: var(--color-success);
            border-color: var(--color-success);
            color: #fff;
        }

        .btn-success:hover {
            background: #047857;
            border-color: #047857;
            color: #fff;
        }

        .btn-outline-secondary {
            border-color: var(--color-border);
            color: var(--color-muted);
            background: transparent;
        }

        .btn-outline-secondary:hover {
            background: var(--color-bg);
            border-color: #cbd5e1;
            color: var(--color-text);
        }

        .btn-dark {
            background: var(--color-text);
            border-color: var(--color-text);
            color: #fff;
        }

        /* ── Badges ────────────────────────────────────────── */
        .badge {
            font-weight: 600;
            font-size: 11px;
            padding: 3px 8px;
            border-radius: 20px;
            letter-spacing: .03em;
        }

        .badge-in {
            background: var(--color-success-soft);
            color: var(--color-success);
        }

        .badge-out {
            background: var(--color-warning-soft);
            color: var(--color-warning);
        }

        .badge-pending {
            background: var(--color-warning-soft);
            color: var(--color-warning);
        }

        .badge-received,
        .badge-completed {
            background: var(--color-success-soft);
            color: var(--color-success);
        }

        .badge-danger {
            background: var(--color-danger-soft);
            color: var(--color-danger);
        }

        .badge-neutral {
            background: #f1f5f9;
            color: var(--color-muted);
            border: 1px solid var(--color-border);
        }

        /* ── Forms ─────────────────────────────────────────── */
        .form-label {
            font-size: 12.5px;
            font-weight: 600;
            color: #475569;
            margin-bottom: 5px;
        }

        .form-control,
        .form-select {
            font-size: 13.5px;
            border-color: var(--color-border);
            border-radius: var(--radius-sm);
            color: var(--color-text);
            background: var(--color-surface);
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px var(--color-primary-soft);
        }

        /* ── Operation cards (forms) ───────────────────────── */
        .op-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .op-card-header {
            padding: .85rem 1.4rem;
            border-bottom: 1px solid var(--color-border);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .op-card-icon {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            background: var(--color-primary-soft);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-primary);
            flex-shrink: 0;
        }

        .op-card-title {
            font-family: 'Manrope', sans-serif;
            font-size: 14px;
            font-weight: 700;
            margin: 0;
            color: var(--color-text);
        }

        .op-card-body {
            padding: 1.25rem 1.4rem;
        }

        /* ── Alert override ────────────────────────────────── */
        .alert {
            border-radius: var(--radius-sm);
            font-size: 13.5px;
            border-width: 0;
            border-left: 4px solid;
        }

        .alert-success {
            background: var(--color-success-soft);
            border-left-color: var(--color-success);
            color: #065f46;
        }

        .alert-danger {
            background: var(--color-danger-soft);
            border-left-color: var(--color-danger);
            color: #991b1b;
        }

        /* ── Chart container ───────────────────────────────── */
        .chart-frame {
            height: 300px;
            position: relative;
        }

        /* ── Report bar ────────────────────────────────────── */
        .report-bar {
            background: linear-gradient(90deg, var(--color-primary), #60a5fa);
            border-radius: 0 4px 4px 0;
            height: 16px;
            min-width: 3px;
        }

        .report-bar.danger {
            background: linear-gradient(90deg, var(--color-danger), #f87171);
        }

        /* ── Ref number mono ───────────────────────────────── */
        .ref-mono {
            font-family: 'Courier New', monospace;
            font-size: 12px;
            color: var(--color-muted);
        }

        /* ── Empty state ───────────────────────────────────── */
        .empty-state {
            padding: 2.5rem 1rem;
            text-align: center;
            color: var(--color-muted);
        }

        .empty-state svg {
            margin-bottom: 10px;
            opacity: .35;
        }

        .empty-state p {
            margin: 0;
            font-size: 13.5px;
        }

        /* ── Mobile header ─────────────────────────────────── */
        .mobile-header {
            display: none;
            align-items: center;
            background: var(--color-sidebar-bg);
            justify-content: space-between;
            padding: .9rem 1rem;
            position: sticky;
            top: 0;
            z-index: 200;
        }

        /* ── Responsive ────────────────────────────────────── */
        @media (max-width: 900px) {
            .kpi-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 767.98px) {
            .app-shell {
                display: block;
            }

            .sidebar {
                display: none;
            }

            .main-content {
                margin-left: 0;
            }

            .topbar {
                display: none;
            }

            .mobile-header {
                display: flex;
            }

            .page-header {
                align-items: flex-start;
                flex-direction: column;
                margin-bottom: 1.25rem;
            }

            .kpi-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: .75rem;
            }
        }
    </style>
</head>

<body>
    <div class="app-shell">
        <!-- ── Sidebar ─────────────────────────────────────── -->
        <aside class="sidebar" aria-label="Main navigation">
            <a class="sidebar-logo" href="/">
                <div class="sidebar-logo-mark">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                        stroke-linecap="round" stroke-linejoin="round" color="#fff">
                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                </div>
                <span class="sidebar-logo-text">Stock<span>Flow</span></span>
            </a>

            <nav>
                <div class="sidebar-section">
                    <p class="sidebar-section-title">{{translate "Overview"}}</p>
                    <a class="sidebar-link" href="/" data-page="{{translate 'Dashboard'}}">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" />
                            <rect x="14" y="3" width="7" height="7" />
                            <rect x="14" y="14" width="7" height="7" />
                            <rect x="3" y="14" width="7" height="7" /></svg>
                        {{translate "Dashboard"}}
                    </a>
                    <a class="sidebar-link" href="/financial-journal" data-page="{{translate 'Financial journal'}}">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5A2.5 2.5 0 016.5 17H20" />
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z" /></svg>
                        {{translate "Financial journal"}}
                    </a>
                </div>

                <div class="sidebar-section">
                    <p class="sidebar-section-title">{{translate "Costing methods"}}</p>
                    <a class="sidebar-link" href="/stock-report?method=WAC" data-page="{{translate 'WAC report'}}"
                        data-costing-report="WAC">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9" />
                            <path
                                d="M12 7v10M15 9.5c0-1.1-1.3-2-3-2s-3 0-3 1.5 1.3 1.8 3 2 3 1 3 2-1.3 2-3 2-3-1-3-2" />
                            </svg>
                        {{translate "WAC report"}}
                    </a>
                    <a class="sidebar-link" href="/stock-report?method=FIFO" data-page="{{translate 'FIFO report'}}"
                        data-costing-report="FIFO">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
