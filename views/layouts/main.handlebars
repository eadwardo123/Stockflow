    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Active sidebar link
        const path = window.location.pathname
        const selectedReportMethod = new URLSearchParams(window.location.search).get('method') ? .toUpperCase() || 'WAC'
        document.querySelectorAll('.sidebar-link').forEach((link) => {
            const href = link.getAttribute('href')
            const costingMethod = link.dataset.costingReport
            const isSelectedCostingReport = path === '/stock-report' &&
                costingMethod &&
                selectedReportMethod === costingMethod
            if (href === path || isSelectedCostingReport) {
                link.classList.add('active')
                const page = link.dataset.page
                if (page) document.getElementById('topbar-page').textContent = page
            }
        })

        // Top bar date
        const d = new Date()
        const workspaceLanguage = {
            {
                {
                    json workspacePreferences.language_code
                }
            }
        }
        const workspaceCurrency = {
            {
                {
                    json workspacePreferences.currency_code
                }
            }
        }
        const workspaceLocale = workspaceLanguage === 'id' ? 'id-ID' : 'en-US'
        document.getElementById('topbar-date').textContent = d.toLocaleDateString(workspaceLocale, {
            weekday: 'short',
            month: 'short',
            day: 'numeric',
            year: 'numeric'
        })

        const refreshPaymentReminders = async (showSystemNotification = false) => {
            try {
                const response = await fetch('/api/payment-reminders')
                if (!response.ok) return
                const {
                    reminders
                } = await response.json()
                const banner = document.getElementById('paymentReminderBanner')
                const title = document.getElementById('paymentReminderTitle')
                const list = document.getElementById('paymentReminderList')
                list.replaceChildren()
                banner.hidden = !reminders.length
                if (!reminders.length) return
                title.textContent = workspaceLanguage === 'id' ?
                    `${reminders.length} pembayaran jatuh tempo atau terlambat` :
                    `${reminders.length} payment${reminders.length === 1 ? '' : 's'} due or overdue`
                for (const reminder of reminders) {
                    const item = document.createElement('li')
                    const amount = new Intl.NumberFormat(workspaceLocale, {
                        style: 'currency',
                        currency: workspaceCurrency
                    }).format(Number(reminder.amount))
                    const timing = workspaceLanguage === 'id' ?
                        reminder.timing === 'Overdue' ? 'Terlambat' : 'Jatuh tempo hari ini' :
                        reminder.timing
                    const action = workspaceLanguage === 'id' ? reminder.action === 'Pay' ? 'Bayar' : 'Tagih' :
                        reminder.action
                    const dueLabel = workspaceLanguage === 'id' ? 'jatuh tempo' : 'due'
                    item.textContent =
                        `${timing}: ${action} ${reminder.name} · ${reminder.number} · ${amount} · ${dueLabel} ${reminder.dueDate}`
                    list.append(item)
                }
                if (showSystemNotification && 'Notification' in window && Notification.permission ===
                    'granted') {
                    const unseenReminders = reminders.filter((reminder) => {
                        const key = `stockflow-payment-reminder-${reminder.id}-${reminder.dueDate}`
                        if (localStorage.getItem(key)) return false
                        localStorage.setItem(key, 'sent')
                        return true
                    })
                    if (unseenReminders.length) {
                        const firstReminder = unseenReminders[0]
                        const amount = new Intl.NumberFormat(workspaceLocale, {
                            style: 'currency',
                            currency: workspaceCurrency
                        }).format(Number(firstReminder.amount))
                        const timing = workspaceLanguage === 'id' ?
                            firstReminder.timing === 'Overdue' ? 'Terlambat' : 'Jatuh tempo hari ini' :
                            firstReminder.timing
                        const action = workspaceLanguage === 'id' ? firstReminder.action === 'Pay' ? 'Bayar' :
                            'Tagih' : firstReminder.action
                        const notification = new Notification(workspaceLanguage === 'id' ?
                            `Pembayaran ${timing.toLowerCase()}` : `${timing} payment`, {
                                body: `${action} ${firstReminder.name}: ${amount}`,
                                tag: `stockflow-payment-${firstReminder.id}`
                            })
                        notification.onclick = () => {
                            window.focus()
                            window.location.href = '/financial-journal'
                        }
                    }
                }
            } catch (error) {
                console.error('Unable to load payment reminders:', error)
            }
        }

        const notificationPermissionButton = document.getElementById('paymentNotificationPermission')
        const updateNotificationPermissionButton = () => {
            if (!('Notification' in window)) {
                notificationPermissionButton.disabled = true
                notificationPermissionButton.textContent = 'Notifications unavailable'
                return
            }
            notificationPermissionButton.textContent = Notification.permission === 'granted' ?
                'Alerts enabled' :
                Notification.permission === 'denied' ? 'Alerts blocked' : 'Enable alerts'
            notificationPermissionButton.disabled = Notification.permission === 'denied'
        }
        updateNotificationPermissionButton()
        notificationPermissionButton.addEventListener('click', async () => {
            if (!('Notification' in window)) return
            const permission = await Notification.requestPermission()
            updateNotificationPermissionButton()
            if (permission === 'granted') await refreshPaymentReminders(true)
        })

        refreshPaymentReminders('Notification' in window && Notification.permission === 'granted')

        // Real-time socket listener
        const socket = io();
        socket.on('connect', () => {
            console.log('Connected to StockFlow real-time server');
        });
        socket.on('inventory-updated', (data) => {
            console.log('Update received:', data);
            window.location.reload();
        });

        window.setInterval(() => refreshPaymentReminders(true), 5 * 60 * 1000)
    </script>
