<section id="pre-orders" class="mt-5">
    <div class="section-panel-header mb-3">
        <div>
            <h2 class="section-panel-title">{{translate "Customer pre-orders"}}</h2>
            <p class="section-panel-subtitle">{{translate "Record demand and expected delivery before stock arrives"}}</p>
        </div>
    </div>

    <div id="preOrderMessage" class="alert d-none mb-4" role="alert"></div>

    <div class="row g-4 mb-4">
        <div class="col-xl-6">
            <div class="op-card">
                <div class="op-card-header">
                    <div class="op-card-icon" style="background:rgba(37,99,235,.1);color:#2563eb;">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16v11H4z"/><path d="M8 7V5a4 4 0 018 0v2"/><path d="M8 12h8"/></svg>
                    </div>
                    <h3 class="op-card-title">{{translate "Create pre-order"}}</h3>
                </div>
                <div class="op-card-body">
                    <form id="preOrderForm" class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">{{translate "Customer"}}</label>
                            <input name="customerName" class="form-control" placeholder="e.g. Retail Store A" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">{{translate "Order date"}}</label>
                            <input name="orderDate" type="date" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">{{translate "Item"}}</label>
                            <select name="itemId" class="form-select" required>
                                <option value="">Choose item</option>
                                {{#each items}}
                                <option value="{{id}}">{{item_name}} — {{brand_name}} ({{item_code}})</option>
                                {{/each}}
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">{{translate "Quantity"}}</label>
                            <input name="quantity" type="number" min="0.001" step="0.001" class="form-control" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">{{translate "Unit price"}}</label>
                            <input name="unitPrice" type="number" min="0.01" step="0.01" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">{{translate "Expected delivery"}}</label>
                            <input name="expectedDate" type="date" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">{{translate "Notes"}}</label>
                            <input name="notes" class="form-control" placeholder="Optional notes">
                        </div>
                        <div class="col-12 pt-1">
                            <button class="btn btn-primary" type="submit">{{translate "Save pre-order"}}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="op-card">
                <div class="op-card-header">
                    <div class="op-card-icon" style="background:rgba(5,150,105,.10);color:#059669;">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>
                    </div>
                    <h3 class="op-card-title">{{translate "Pre-order overview"}}</h3>
                </div>
                <div class="op-card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="hero-panel-card">
                                <div class="hero-panel-label">{{translate "Pending"}}</div>
                                <div class="hero-panel-value">{{summary.pending}}</div>
                                <div class="hero-panel-sub">Awaiting fulfillment</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="hero-panel-card">
                                <div class="hero-panel-label">{{translate "Fulfilled"}}</div>
                                <div class="hero-panel-value">{{summary.fulfilled}}</div>
                                <div class="hero-panel-sub">Completed orders</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="hero-panel-card">
                                <div class="hero-panel-label">{{translate "Cancelled"}}</div>
                                <div class="hero-panel-value">{{summary.cancelled}}</div>
                                <div class="hero-panel-sub">Closed reservations</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="section-panel">
        <div class="section-panel-header">
            <div>
                <h3 class="section-panel-title">{{translate "Pre-order list"}}</h3>
                <p class="section-panel-subtitle">{{translate "Customer reservations and expected delivery timing"}}</p>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>{{translate "Customer"}}</th>
                        <th>{{translate "Item"}}</th>
                        <th>{{translate "Quantity"}}</th>
                        <th>{{translate "Unit price"}}</th>
                        <th>{{translate "Expected"}}</th>
                        <th>{{translate "Status"}}</th>
                        <th>{{translate "Action"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each preOrders}}
                    <tr>
                        <td class="fw-semibold">{{customer_name}}</td>
                        <td>{{item_name}} <span class="ref-mono">{{item_code}}</span></td>
                        <td>{{quantity}}</td>
                        <td>{{rupiah unit_price}}</td>
                        <td class="text-muted" style="font-size:12px;">{{#if expected_date}}{{expected_date}}{{else}}—{{/if}}</td>
                        <td><span class="badge {{#if (eq status 'PENDING')}}badge-pending{{else if (eq status 'FULFILLED')}}badge-received{{else}}badge-neutral{{/if}}">{{status}}</span></td>
                        <td>
                            {{#if (eq status 'PENDING')}}
                            <button class="btn btn-sm btn-success fulfill-preorder" data-id="{{id}}">{{translate "Mark fulfilled"}}</button>
                            {{else}}
                            <span class="text-muted" style="font-size:12px;">No action</span>
                            {{/if}}
                        </td>
                    </tr>
                    {{else}}
                    <tr><td colspan="7"><div class="empty-state"><p>{{translate "No pre-orders recorded yet."}}</p></div></td></tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>
const preOrderMessage = document.getElementById('preOrderMessage')

const setPreOrderMessage = (type, text) => {
    preOrderMessage.className = `alert alert-${type} mb-4`
    preOrderMessage.textContent = text
    preOrderMessage.classList.remove('d-none')
}

document.getElementById('preOrderForm')?.addEventListener('submit', async (event) => {
    event.preventDefault()
    const payload = Object.fromEntries(new FormData(event.target))
    try {
        const response = await fetch('/api/pre-orders', {
            method: 'POST',
            headers: {'Content-Type': 'application/json', ...window.stockFlowCsrfHeaders()},
            body: JSON.stringify(payload)
        })
        const result = await response.json()
        if (!response.ok) throw new Error(result.error)
        setPreOrderMessage('success', result.message)
        setTimeout(() => location.reload(), 500)
    } catch (error) {
        setPreOrderMessage('danger', error.message)
    }
})

document.querySelectorAll('.fulfill-preorder').forEach((button) => {
    button.addEventListener('click', async () => {
        try {
            const response = await fetch(`/api/pre-orders/${button.dataset.id}/status`, {
                method: 'PATCH',
                headers: {'Content-Type': 'application/json', ...window.stockFlowCsrfHeaders()},
                body: JSON.stringify({status: 'FULFILLED'})
            })
            const result = await response.json()
            if (!response.ok) throw new Error(result.error)
            setPreOrderMessage('success', result.message)
            setTimeout(() => location.reload(), 500)
        } catch (error) {
            setPreOrderMessage('danger', error.message)
        }
    })
})
</script>