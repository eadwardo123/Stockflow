<div class="page-header">
    <div>
        <p class="page-eyebrow">Workspace settings</p>
        <h1 class="page-title">Team access</h1>
        <p class="page-subtitle">Manage who can work in this company's StockFlow workspace.</p>
    </div>
</div>

<div id="teamMessage" class="alert d-none mb-4" role="alert"></div>

{{#if canManage}}
<div class="op-card mb-4">
    <div class="op-card-header"><h2 class="op-card-title">Invite a team member</h2></div>
    <div class="op-card-body">
        <form id="inviteForm" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label for="inviteRole" class="form-label">Workspace role</label>
                <select id="inviteRole" name="role" class="form-select" required>
                    {{#if isOwner}}<option value="admin">Admin</option>{{/if}}
                    <option value="staff">Staff</option>
                </select>
            </div>
            <div class="col-md-4"><button class="btn btn-primary" type="submit">Create invite link</button></div>
        </form>
        <div id="inviteResult" class="mt-3" hidden>
            <label for="inviteUrl" class="form-label">Share this one-time link within 7 days</label>
            <div class="input-group">
                <input id="inviteUrl" class="form-control" type="url" readonly>
                <button id="copyInvite" class="btn btn-outline-secondary" type="button" aria-label="Copy invite link" title="Copy invite link">Copy</button>
            </div>
        </div>
    </div>
</div>
{{/if}}

<div class="section-panel">
    <div class="section-panel-header">
        <div>
            <h2 class="section-panel-title">Workspace members</h2>
            <p class="section-panel-subtitle">{{members.length}} accounts connected to this workspace</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Member</th><th>Email</th><th>Role</th><th>Status</th><th>Joined</th>{{#if isOwner}}<th>Actions</th>{{/if}}</tr></thead>
            <tbody>
                {{#each members}}
                <tr data-member-row data-user-id="{{id}}">
                    <td class="fw-semibold">{{username}}</td>
                    <td>{{email}}</td>
                    <td>
                        {{#if (eq role 'owner')}}
                        <span class="badge badge-neutral">Owner</span>
                        {{else if (eq role 'admin')}}
                        <span class="badge badge-received">Admin</span>
                        {{else}}
                        <span class="badge badge-pending">Staff</span>
                        {{/if}}
                    </td>
                    <td>{{#if is_active}}Active{{else}}Access revoked{{/if}}</td>
                    <td class="text-muted">{{joined_date}}</td>
                    {{#if ../isOwner}}
                    <td>
                        {{#unless (eq role 'owner')}}
                        <div class="d-flex gap-2 align-items-center flex-wrap">
                            <select class="form-select form-select-sm" data-member-role aria-label="Role for {{username}}" style="width:auto;min-width:105px;">
                                <option value="admin" {{#if (eq role 'admin')}}selected{{/if}}>Admin</option>
                                <option value="staff" {{#if (eq role 'staff')}}selected{{/if}}>Staff</option>
                            </select>
                            <button class="btn btn-sm btn-outline-primary" type="button" data-member-action="role">Save role</button>
                            <button class="btn btn-sm btn-outline-danger" type="button" data-member-action="active" data-active="{{is_active}}">
                                {{#if is_active}}Revoke access{{else}}Restore access{{/if}}
                            </button>
                        </div>
                        {{else}}
                        <span class="text-muted">Owner</span>
                        {{/unless}}
                    </td>
                    {{/if}}
                </tr>
                {{else}}
                <tr><td colspan="6"><div class="empty-state"><p>No workspace members found.</p></div></td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>

{{#if invites.length}}
<div class="section-panel mt-4">
    <div class="section-panel-header"><div><h2 class="section-panel-title">Open invitations</h2><p class="section-panel-subtitle">Links expire after seven days and can only be used once.</p></div></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Role</th><th>Created</th><th>Expires</th></tr></thead>
            <tbody>{{#each invites}}<tr><td>{{role}}</td><td>{{created_at}}</td><td>{{expires_at}}</td></tr>{{/each}}</tbody>
        </table>
    </div>
</div>
{{/if}}

<script>
const teamMessage = document.getElementById('teamMessage')

const showTeamMessage = (type, text) => {
    teamMessage.className = `alert alert-${type} mb-4`
    teamMessage.textContent = text
    teamMessage.classList.remove('d-none')
}

const sendTeamRequest = async (url, method, body) => {
    const response = await fetch(url, {
        method,
        headers: {'Content-Type': 'application/json', ...window.stockFlowCsrfHeaders()},
        body: JSON.stringify(body)
    })
    const result = await response.json()
    if (!response.ok) throw new Error(result.error || 'Could not update workspace access')
    return result
}

document.getElementById('inviteForm')?.addEventListener('submit', async (event) => {
    event.preventDefault()
    try {
        const result = await sendTeamRequest('/api/workspace-invites', 'POST', Object.fromEntries(new FormData(event.target)))
        document.getElementById('inviteUrl').value = new URL(result.invitePath, window.location.origin).href
        document.getElementById('inviteResult').hidden = false
        showTeamMessage('success', result.message)
    } catch (error) {
        showTeamMessage('danger', error.message)
    }
})

document.getElementById('copyInvite')?.addEventListener('click', async () => {
    try {
        await navigator.clipboard.writeText(document.getElementById('inviteUrl').value)
        showTeamMessage('success', 'Invite link copied')
    } catch (error) {
        showTeamMessage('danger', 'Copy failed. Select and copy the link manually.')
    }
})

document.querySelectorAll('[data-member-action]').forEach((button) => {
    button.addEventListener('click', async () => {
        const row = button.closest('[data-member-row]')
        const userId = row.dataset.userId
        try {
            if (button.dataset.memberAction === 'role') {
                const role = row.querySelector('[data-member-role]').value
                await sendTeamRequest(`/api/workspace-members/${userId}/role`, 'PATCH', {role})
            } else {
                const isActive = button.dataset.active !== 'true'
                await sendTeamRequest(`/api/workspace-members/${userId}/active`, 'PATCH', {isActive})
            }
            location.reload()
        } catch (error) {
            showTeamMessage('danger', error.message)
        }
    })
})
</script>