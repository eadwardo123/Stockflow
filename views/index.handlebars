<style>
  .hero-shell {
    background: linear-gradient(135deg, rgba(37,99,235,0.05), rgba(5,150,105,0.08));
    border: 1px solid #dfeaf7;
    border-radius: 18px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    display: grid;
    grid-template-columns: 1.5fr 0.9fr;
    gap: 1.5rem;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: rgba(37,99,235,0.1);
    border: 1px solid rgba(37,99,235,0.12);
    color: #1d4ed8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    margin: 0.85rem 0 0.65rem;
    font-size: clamp(2rem, 3vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .hero-copy p {
    margin: 0;
    color: #475569;
    font-size: 0.98rem;
    max-width: 58ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.2rem;
  }

  .hero-pills {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .hero-pills li {
    background: rgba(15,23,42,0.02);
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    padding: 0.45rem 0.7rem;
    font-size: 0.74rem;
    color: #334155;
    font-weight: 600;
  }

  .hero-panel {
    background: rgba(255,255,255,0.75);
    border: 1px solid rgba(148,163,184,0.5);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.1rem;
    gap: 0.8rem;
  }

  .hero-panel-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 0.8rem 0.9rem;
  }

  .hero-panel-label {
    color: #64748b;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .hero-panel-value {
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.2;
    color: #0f172a;
    margin-top: 0.2rem;
    font-family: 'Manrope', sans-serif;
  }

  .hero-panel-sub {
    color: #475569;
    font-size: 0.76rem;
    margin-top: 0.2rem;
  }

  @media (max-width: 991px) {
    .hero-shell {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="page-header" style="margin-bottom: 1.25rem;">
    <div>
        <p class="page-eyebrow">{{translate "Inventory control"}}</p>
        <h1 class="page-title">{{translate "Operations Dashboard"}}</h1>
        <p class="page-subtitle">{{translate "Live view of stock health, purchasing activity, and recent movements."}}</p>
    </div>
    <a class="btn btn-primary" href="/stock-transactions#transaction-form">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:5px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        {{translate "Record movement"}}
    </a>
    </div>
<div class="hero-shell">
    <div class="hero-copy">
        <span class="hero-badge">StockFlow</span>
        <h1>{{translate "Manage inventory with confidence."}}</h1>
        <p>{{translate "Keep warehouse stock accurate, review supplier activity, and understand the financial impact of every movement from one operational dashboard."}}</p>
        <div class="hero-actions">
            <a class="btn btn-primary" href="/purchase-orders">{{translate "Create purchase order"}}</a>
            <a class="btn btn-outline-secondary" href="/tutorial">{{translate "Start beginner tutorial"}}</a>
            {{#if canManageMasterData}}
            <a class="btn btn-outline-secondary" href="/master-data">{{translate "Manage master data"}}</a>
            {{/if}}
        </div>
        <ul class="hero-pills">
            <li>{{translate "Purchase orders"}}</li>
            <li>{{translate "Transfers"}}</li>
            <li>{{translate "Invoices"}}</li>
            <li>{{translate "Costing reports"}}</li>
        </ul>
    </div>

    <div class="hero-panel">
        {{#if summary}}
        <div class="hero-panel-card">
            <div class="hero-panel-label">{{translate "Items tracked"}}</div>
            <div class="hero-panel-value">{{summary.item_count}}</div>
            <div class="hero-panel-sub">{{translate "Current product catalog"}}</div>
        </div>
        <div class="hero-panel-card">
            <div class="hero-panel-label">{{translate "Stock on hand"}}</div>
            <div class="hero-panel-value">{{summary.total_stock}}</div>
            <div class="hero-panel-sub">{{translate "Units across all warehouses"}}</div>
        </div>
        <div class="hero-panel-card">
            <div class="hero-panel-label">{{translate "Workflow status"}}</div>
            <div class="hero-panel-value">{{summary.pending_orders}}</div>
            <div class="hero-panel-sub">{{translate "Pending purchase orders"}}</div>
        </div>
        {{else}}
        <div class="hero-panel-card">
            <div class="hero-panel-label">{{translate "Workflow status"}}</div>
            <div class="hero-panel-value">{{translate "Ready"}}</div>
            <div class="hero-panel-sub">{{translate "Add stock data to begin tracking operations"}}</div>
        </div>
        {{/if}}
    </div>
</div>

{{#if showOnboarding}}
<div class="section-panel mb-4">
    <div class="section-panel-header">
        <div>
            <h2 class="section-panel-title">{{translate "Set up your workspace"}}</h2>
            <p class="section-panel-subtitle">{{translate "Progress is saved as you add real business records."}}</p>
        </div>
        {{#if canManageMasterData}}<button id="skipOnboarding" class="btn btn-sm btn-outline-secondary" type="button">{{translate "Hide checklist"}}</button>{{/if}}
    </div>
    <div class="section-panel-body">
        <div class="row g-2">
            {{#each setupSteps}}
            <div class="col-md-6">
                <div class="hero-panel-card d-flex align-items-center justify-content-between gap-3">
                    <div>
                        <div class="hero-panel-label">{{translate label}}</div>
                        <div class="hero-panel-sub">{{#if complete}}{{translate "Completed"}}{{else}}{{translate "Still needed"}}{{/if}}</div>
                    </div>
                    {{#if ../canManageMasterData}}
                    <a class="btn btn-sm {{#if complete}}btn-outline-secondary{{else}}btn-primary{{/if}}" href="{{href}}">{{#if complete}}{{translate "Review"}}{{else}}{{translate "Open"}}{{/if}}</a>
                    {{else if (eq href '/purchase-orders')}}
                    <a class="btn btn-sm btn-primary" href="{{href}}">{{translate "Open"}}</a>
                    {{else}}
                    <span class="text-muted small">{{translate "Ask an admin"}}</span>
                    {{/if}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>
{{else if onboardingHidden}}
<div class="section-panel mb-4">
    <div class="section-panel-header">
        <div><h2 class="section-panel-title">{{translate "Setup checklist hidden"}}</h2><p class="section-panel-subtitle">{{translate "Your progress is saved. Reopen it whenever you are ready."}}</p></div>
        {{#if canManageMasterData}}<button id="reopenOnboarding" class="btn btn-sm btn-outline-primary" type="button">{{translate "Show checklist"}}</button>{{/if}}
    </div>
</div>
{{/if}}

<div class="section-panel mb-4">
    <div class="section-panel-header">
        <div><h2 class="section-panel-title">{{translate "Needs attention"}}</h2><p class="section-panel-subtitle">{{translate "Open an item to review and resolve it."}}</p></div>
    </div>
    <div class="row g-3 p-3">
        <div class="col-sm-6 col-xl-3">
            <a href="/stock-report?method=WAC" class="text-decoration-none">
                <div class="hero-panel-card h-100"><div class="hero-panel-label">{{translate "Low stock items"}}</div><div class="hero-panel-value">{{summary.low_stock_items}}</div><div class="hero-panel-sub">{{translate "At or below minimum stock"}}</div></div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a href="/financial-journal" class="text-decoration-none">
                <div class="hero-panel-card h-100"><div class="hero-panel-label">{{translate "Payments due"}}</div><div class="hero-panel-value">{{dueSummary.due_count}}</div><div class="hero-panel-sub">{{rupiah dueSummary.due_amount}} {{translate "due or overdue"}}</div></div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a href="/purchase-orders" class="text-decoration-none">
                <div class="hero-panel-card h-100"><div class="hero-panel-label">{{translate "Pending purchase orders"}}</div><div class="hero-panel-value">{{summary.pending_orders}}</div><div class="hero-panel-sub">{{translate "Awaiting receipt"}}</div></div>
            </a>
        </div>
        <div class="col-sm-6 col-xl-3">
            <a href="/purchase-orders#pre-orders" class="text-decoration-none">
                <div class="hero-panel-card h-100"><div class="hero-panel-label">{{translate "Pending pre-orders"}}</div><div class="hero-panel-value">{{summary.pending_preorders}}</div><div class="hero-panel-sub">{{translate "Awaiting fulfillment"}}</div></div>
            </a>
        </div>
    </div>
</div>

{{!-- Quick action cards -------------------------------------------------------}}
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a href="/purchase-orders" style="text-decoration:none;">
            <div style="background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:1rem 1.2rem;display:flex;align-items:center;gap:12px;transition:box-shadow .15s ease;" onmouseover="this.style.boxShadow='0 4px 12px rgba(15,23,42,.1)'" onmouseout="this.style.boxShadow='none'">
                <div style="width:40px;height:40px;background:#eff6ff;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#2563eb;flex-shrink:0;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                </div>
                <div>
                    <div style="font-weight:700;font-size:13.5px;color:#0f172a;">Restock from supplier</div>
                    <div style="font-size:12px;color:#64748b;margin-top:1px;">Create a purchase order → receive stock</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/stock-transactions#transaction-form" style="text-decoration:none;">
            <div style="background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:1rem 1.2rem;display:flex;align-items:center;gap:12px;transition:box-shadow .15s ease;" onmouseover="this.style.boxShadow='0 4px 12px rgba(15,23,42,.1)'" onmouseout="this.style.boxShadow='none'">
                <div style="width:40px;height:40px;background:#f0fdf4;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#059669;flex-shrink:0;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 014-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg>
                </div>
                <div>
                    <div style="font-weight:700;font-size:13.5px;color:#0f172a;">Record customer sale</div>
                    <div style="font-size:12px;color:#64748b;margin-top:1px;">Sell to customer or log a return</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/transfers" style="text-decoration:none;">
            <div style="background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:1rem 1.2rem;display:flex;align-items:center;gap:12px;transition:box-shadow .15s ease;" onmouseover="this.style.boxShadow='0 4px 12px rgba(15,23,42,.1)'" onmouseout="this.style.boxShadow='none'">
                <div style="width:40px;height:40px;background:#fffbeb;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#d97706;flex-shrink:0;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                </div>
                <div>
                    <div style="font-weight:700;font-size:13.5px;color:#0f172a;">Transfer between warehouses</div>
                    <div style="font-size:12px;color:#64748b;margin-top:1px;">Move stock from one location to another</div>
                </div>
