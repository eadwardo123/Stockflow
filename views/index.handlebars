{{#if summary}}
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-card-top">
            <div class="kpi-label">Total items</div>
            <div class="kpi-icon indigo">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
            </div>
        </div>
        <div class="kpi-value">{{summary.item_count}}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-card-top">
            <div class="kpi-label">Total stock</div>
            <div class="kpi-icon emerald">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
        </div>
        <div class="kpi-value">{{summary.total_stock}}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-card-top">
            <div class="kpi-label">Pending orders</div>
            <div class="kpi-icon amber">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
            </div>
        </div>
        <div class="kpi-value">{{summary.pending_orders}}</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-card-top">
            <div class="kpi-label">Pending transfers</div>
            <div class="kpi-icon sky">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
        </div>
        <div class="kpi-value">{{summary.pending_transfers}}</div>
    </div>
</div>
{{/if}}

<div class="section-panel">
    <div class="section-panel-header">
        <div>
            <h2 class="section-panel-title">Recent stock movements</h2>
            <p class="section-panel-subtitle">Audit trail — latest 10 transactions across all warehouses</p>
        </div>
        <a class="btn btn-sm btn-outline-secondary" href="/stock-transactions">View all</a>
    </div>
    {{#if transactions}}
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Warehouse</th>
                    <th>Type</th>
                    <th>Quantity</th>
                    <th>Reference</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                {{#each transactions}}
                <tr>
                    <td class="fw-semibold">{{item_name}}</td>
                    <td class="text-muted">{{warehouse_name}}</td>
                    <td>
                        <span class="badge {{#if (eq transaction_type 'IN')}}badge-in{{else}}badge-out{{/if}}">
                            {{transaction_type}}
                        </span>
                    </td>
                    <td>{{quantity}}</td>
                    <td><span class="ref-mono">{{reference_number}}</span></td>
                    <td class="text-muted" style="font-size:12px;">{{created_at}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    {{else}}
    <div class="empty-state">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <p>No stock movements have been recorded yet.</p>
    </div>
    {{/if}}
</div>

<script>
const updateOnboardingStatus = async (status) => {
    const response = await fetch('/api/onboarding/status', {
        method: 'PATCH',
        headers: {'Content-Type': 'application/json', ...window.stockFlowCsrfHeaders()},
        body: JSON.stringify({status})
    })
    const result = await response.json()
    if (!response.ok) throw new Error(result.error || 'Could not update the setup checklist')
    location.reload()
}

document.getElementById('skipOnboarding')?.addEventListener('click', async () => {
    try {
        await updateOnboardingStatus('skipped')
    } catch (error) {
        window.alert(error.message)
    }
})

document.getElementById('reopenOnboarding')?.addEventListener('click', async () => {
    try {
        await updateOnboardingStatus('active')
    } catch (error) {
        window.alert(error.message)
    }
})
</script>