<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if isRegister}}Create account{{else}}Sign in{{/if}} · StockFlow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            color-scheme: light;
            --ink: #15231f;
            --muted: #66756e;
            --line: #dce5df;
            --paper: #fbfdfb;
            --green: #176b4a;
            --green-dark: #10563b;
            --lime: #d6ef74;
            --error: #a83232;
        }

        * { box-sizing: border-box; }

        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 28px 18px;
            color: var(--ink);
            background-color: #e9f0eb;
            background-image: repeating-linear-gradient(135deg, transparent 0 22px, rgba(21, 65, 44, .035) 22px 23px);
            font-family: 'DM Sans', sans-serif;
        }

        .auth-panel {
            width: min(100%, 440px);
            padding: clamp(28px, 7vw, 48px);
            background: var(--paper);
            border: 1px solid rgba(21, 65, 44, .12);
            box-shadow: 0 22px 70px rgba(25, 57, 42, .12);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--ink);
            text-decoration: none;
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 17px;
        }

        .brand-mark {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            background: var(--green);
            color: var(--lime);
            font-size: 19px;
        }

        .eyebrow {
            margin: 38px 0 8px;
            color: var(--green);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            font-family: 'Manrope', sans-serif;
            font-size: 30px;
            line-height: 1.2;
        }

        .intro {
            margin: 10px 0 28px;
            color: var(--muted);
            font-size: 14px;
        }

        .field { margin: 0 0 17px; }

        label {
            display: block;
            margin-bottom: 7px;
            font-size: 13px;
            font-weight: 700;
        }

        input {
            width: 100%;
            min-height: 46px;
            padding: 11px 13px;
            border: 1px solid var(--line);
            border-radius: 3px;
            background: #fff;
            color: var(--ink);
            font: inherit;
            font-size: 14px;
        }

        input:focus {
            outline: 3px solid rgba(23, 107, 74, .15);
            border-color: var(--green);
        }

        .error {
            margin: 0 0 18px;
            padding: 11px 13px;
            border-left: 3px solid var(--error);
            background: #fff0f0;
            color: var(--error);
            font-size: 13px;
        }

        .submit {
            width: 100%;
            min-height: 47px;
            margin-top: 4px;
            border: 0;
            border-radius: 3px;
            background: var(--green);
            color: #fff;
            font: inherit;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
        }

        .submit:hover { background: var(--green-dark); }

        .switch {
            margin: 22px 0 0;
            color: var(--muted);
            text-align: center;
            font-size: 13px;
        }

        .switch a { color: var(--green); font-weight: 700; }
    </style>
</head>
<body>
    <main class="auth-panel">
        <a class="brand" href="/login" aria-label="StockFlow">
            <span class="brand-mark" aria-hidden="true">S</span>
            <span>StockFlow</span>
        </a>
        <p class="eyebrow">Inventory workspace</p>
        <h1>{{#if isRegister}}Create your account{{else}}Welcome back{{/if}}</h1>
        <p class="intro">{{#if isRegister}}Set up an account to access StockFlow.{{else}}Sign in to continue to your inventory workspace.{{/if}}</p>

        {{#if error}}<p class="error" role="alert">{{error}}</p>{{/if}}

        <form action="{{#if isRegister}}/register{{else}}/login{{/if}}" method="post">
            <input type="hidden" name="csrfToken" value="{{csrfToken}}">
            {{#if isRegister}}
                {{#if inviteToken}}<input type="hidden" name="inviteToken" value="{{inviteToken}}">{{/if}}
                <div class="field">
                    <label for="username">Username</label>
                    <input id="username" name="username" type="text" minlength="3" maxlength="32" autocomplete="username" required autofocus>
                </div>
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" maxlength="254" autocomplete="email" required>
                </div>
            {{else}}
                <div class="field">
                    <label for="identity">Username or email</label>
                    <input id="identity" name="identity" type="text" autocomplete="username" required autofocus>
                </div>
            {{/if}}
            <div class="field">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" minlength="8" maxlength="128" autocomplete="{{#if isRegister}}new-password{{else}}current-password{{/if}}" required>
            </div>
            {{#unless isRegister}}<input type="hidden" name="next" value="{{next}}">{{/unless}}
            <button class="submit" type="submit">{{#if isRegister}}Create account{{else}}Sign in{{/if}}</button>
        </form>

        <p class="switch">
            {{#if isRegister}}Already have an account? <a href="/login">Sign in</a>{{else}}New to StockFlow? <a href="/register">Create an account</a>{{/if}}
        </p>
    </main>
</body>
</html>